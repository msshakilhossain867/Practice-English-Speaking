<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0072CE"
    android:orientation="vertical"
    tools:context=".SplashScreenActivity">

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="160dp"
        android:layout_height="160dp"
        android:contentDescription="App Logo"
        android:src="@drawable/splash" />

    <ImageView
        android:id="@+id/logoImage2"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/_300sdp"
        android:layout_centerHorizontal="true"
        android:contentDescription="App Logo"
        android:src="@drawable/splas2" />




    <TextView
        android:id="@+id/titleText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/logoImage2"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="24dp"
        android:fontFamily="sans-serif-condensed"
        android:gravity="center"
        android:letterSpacing="0.05"
        android:text="ENGLISH SPEAKING"
        android:textColor="@android:color/white"
        android:textSize="22sp"
        android:textStyle="bold" />


    <com.citomoltd.englishspeakingpracticeapp.MultiColorProgressBar
        android:id="@+id/roundProgressBar"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:layout_below="@id/titleText"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/_20sdp" />






</RelativeLayout>